project: savantenvs/php-src
target: php-fuzz-unserialize

# libFuzzer target from PHP's --enable-fuzzer SAPI (sapi/fuzzer/fuzzer-unserialize.c), built
# instrumented (ASan+UBSan) on the org base. Seeded from upstream's sapi/fuzzer/corpus/unserialize
# (copied into mayhem/php-fuzz-unserialize/testsuite/ at port time — the canonical per-target seed path).
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/php-fuzz-unserialize/testsuite

cmds:
  - cmd: /mayhem/out/php-fuzz-unserialize
    libfuzzer: true
