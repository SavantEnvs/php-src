project: savantenvs/php-src
target: php-fuzz-exif

# libFuzzer target from PHP's --enable-fuzzer SAPI (sapi/fuzzer/fuzzer-exif.c), built
# instrumented (ASan+UBSan) on the org base. Seeded from upstream's sapi/fuzzer/corpus/exif
# (copied into mayhem/php-fuzz-exif/testsuite/ at port time — the canonical per-target seed path).
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/php-fuzz-exif/testsuite

cmds:
  - cmd: /mayhem/out/php-fuzz-exif
    libfuzzer: true
